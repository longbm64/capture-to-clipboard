#include <windows.h>
#include "resource.h"

// Application Icon (embedded multi-size ICO)
IDI_APP_ICON ICON "../assets/logo.ico"

// Embedded Roboto Fonts so the single .exe is 100% self-contained
IDR_FONT_ROBOTO_REGULAR RCDATA "../assets/fonts/Roboto-Regular.ttf"
IDR_FONT_ROBOTO_BOLD    RCDATA "../assets/fonts/Roboto-Bold.ttf"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Capture To Clipboard"
            VALUE "FileDescription",  "Capture To Clipboard - High-Speed Native C++ Screenshot & Annotation Tool"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "CaptureToClipboard"
            VALUE "OriginalFilename", "CaptureToClipboard.exe"
            VALUE "ProductName",      "Capture To Clipboard"
            VALUE "ProductVersion",   "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
